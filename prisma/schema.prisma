model Project {
  id                 String        @id @default(cuid())
  projectCode        String        @unique
  leadId             String        @unique
  lead               Lead          @relation(fields: [leadId], references: [id])
  designerId         String?
  designer           User?         @relation(fields: [designerId], references: [id])
  phase              ProjectPhase  @default(DESIGN)
  health             ProjectHealth @default(ON_TRACK)
  progressPercent    Int           @default(0)
  contractValue      Float
  outstandingAmount  Float         @default(0)
  location           String?
  handoverTargetDate DateTime?
  /// Task #87 — admin-portal-only "Project Designer" assignment, distinct
  /// from `designerId` (the lead's originally-assigned designer). Set only
  /// via PATCH /api/admin/projects/:id/pd.
  pdUserId           String?
  pd                 User?         @relation("ProjectPD", fields: [pdUserId], references: [id])
  /// Task #87 — admin-portal-only "Design Team Lead" assignment for this
  /// project. Set only via PATCH /api/admin/projects/:id/dtl.
  dtlUserId          String?
  dtl                User?         @relation("ProjectDTL", fields: [dtlUserId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  npsResponses   NPSResponse[]
  collections    Collection[]
  attentionFlags ProjectAttentionFlag[]
  teamMembers    ProjectTeamMember[]

  @@map("projects")
}

/// Task #87 — additional designers on a project's team, beyond the project's
/// own `designerId`. A DESIGNER-initiated request stays PENDING until a BL
/// approves/rejects it; a BL/BRANCH_HEAD-initiated request is auto-approved.
model ProjectTeamMember {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation("ProjectTeamMemberUser", fields: [userId], references: [id])
  /// Enforced (not just UI convention) — see server/src/routes/projects.ts:
  /// at most one APPROVED team member per project may have isPrimary=true.
  isPrimary       Boolean          @default(false)
  status          TeamMemberStatus @default(PENDING)
  requestedById   String
  requestedBy     User             @relation("ProjectTeamMemberRequestedBy", fields: [requestedById], references: [id])
  reviewedById    String?
  reviewedBy      User?            @relation("ProjectTeamMemberReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  /// Required when status is set to REJECTED.
  rejectionReason String?
  createdAt       DateTime         @default(now())

  // A user can only have one active (non-rejected-and-resubmittable) row per
  // project at a time; rejected rows are kept for history and a fresh request
  // creates a new row rather than reusing the old one (enforced in the route,
  // not by this constraint alone, since REJECTED rows must remain queryable).
  @@index([projectId])
  @@index([userId])
  @@map("project_team_members")
}

model Collection {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  milestone   String
  amount      Float
  status      CollectionStatus @default(DUE)
  dueDate     DateTime?
  collectedAt DateTime?
  createdAt   DateTime         @default(now())

  @@map("collections")
}

/// Per-designer, per-cycle sales-performance targets. Cycles run the
/// 16th of one month through the 15th of the next (not calendar months) —
/// see server/src/lib/targetCycle.ts for the boundary computation. Both
/// values are ₹ amounts (value-based, not counts), matching how Booking
/// (Lead.estimatedValue) and PO/Collections (Collection.amount) are already
/// aggregated on the designer dashboard.
model DesignerTarget {
  id          String   @id @default(cuid())
  designerId  String
  designer    User     @relation("DesignerTargets", fields: [designerId], references: [id])
  /// Inclusive start of the 16th–15th cycle this target applies to (IST midnight of the 16th).
  cycleStart  DateTime
  /// Inclusive end of the cycle (IST end-of-day of the 15th of the following month).
  cycleEnd    DateTime
  bookingTargetValue          Decimal  @db.Decimal(12, 2)
  poTargetValue               Decimal  @db.Decimal(12, 2)
  conversionTargetPct         Decimal? @db.Decimal(5, 2)
  averageBookingValueTarget   Decimal? @db.Decimal(12, 2)
  /// Individual count of DIP-qualified bookings expected in this cycle.
  dipTargetCount              Int?
  setById     String
  setBy       User     @relation("DesignerTargetsSetBy", fields: [setById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // One target per designer per cycle; editing an existing cycle updates
  // this row rather than creating a new one (until the cycle is in the past).
  @@unique([designerId, cycleStart])
  @@index([designerId])
  @@map("designer_targets")
}

model ProjectAttentionFlag {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  /// Delayed | At Risk | Blocked | Urgent service
  category    String
  description String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("project_attention_flags")
}

/// Admin-editable credit-incentive rules (one row, id = 'default'). JSON so rule
