# ============================================================
# Interiors by DeX CRM — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Supabase Postgres) ---
# Use the "Transaction" pooler URL for the app (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Use the "Session" pooler or direct URL for Prisma migrations (port 5432)
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- App ---
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
SERVER_PORT=3001

# --- Redis (BullMQ job queue) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string

# --- WhatsApp Business API (Task 4) ---
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Meta Lead Ads ---
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
META_APP_SECRET=your-meta-app-secret
META_FORM_ID=your-lead-gen-form-id
# Verification token — must match what you set in Meta developer portal
META_VERIFY_TOKEN=interiorsbydex_meta_verify

# --- Google Ads (Zapier / direct webhook) ---
# No extra env needed — POST to /api/leads/webhook/google with name/phone/email/utm_* fields

# --- Quote Builder ---
# Base URL of proposals.interiorsbydex.com (embedded as iframe in lead detail)
# VITE_QUOTE_BUILDER_URL=https://proposals.interiorsbydex.com  (set in client/.env)

# --- Custom Domain ---
# Used in email links, webhook URLs, feedback form links
BASE_URL=https://crm.interiorsbydex.com

# ── Twilio WhatsApp ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+1415xxxxxxx

# ── SMTP (Nodemailer) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.youremail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@interiorsbydex.com
