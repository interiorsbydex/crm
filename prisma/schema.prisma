  config      Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("incentive_config")
}

/// Manually approved attendance booster per designer per 16th–15th cycle.
model IncentiveAttendance {
  id          String   @id @default(cuid())
  designerId  String
  cycleStart  DateTime
  awarded     Boolean
  enteredById String
  enteredAt   DateTime @default(now())

  @@unique([designerId, cycleStart])
  @@map("incentive_attendance")
}

/// Saved copy of each designer's computed credits per 16th–15th cycle, so BI tools
/// (Power BI via the rpt_ views) read the same numbers the CRM shows. Refreshed
/// nightly and on demand; source of truth stays calculateDesignerCredits().
model DesignerCreditSnapshot {
  id                      String   @id @default(cuid())
  designerId              String
  cycleStart              DateTime
  cycleEnd                DateTime
  cycleLabel              String
  bookingTargetValue      Decimal? @db.Decimal(14, 2)
  bookingValue            Decimal  @db.Decimal(14, 2)
  bookingCount            Int
  coreStandardCredits     Decimal  @db.Decimal(10, 2)
  coreOverachievementCredits Decimal @db.Decimal(10, 2)
  coreCredits             Decimal  @db.Decimal(10, 2)
  boosterCredits          Decimal  @db.Decimal(10, 2)
  totalCredits            Decimal  @db.Decimal(10, 2)
  eligibilityBand         String
  computedAt              DateTime @default(now())

  @@unique([designerId, cycleStart])
  @@map("designer_credit_snapshots")
}
