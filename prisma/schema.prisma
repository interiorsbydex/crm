/// Task #54 — PD→OB transition checklist. Created when a lead enters
/// PROPOSAL_DISCUSSION; its `completedAt` (set when the welcome mail is sent)
/// gates the PROPOSAL_DISCUSSION → ONBOARDING transition. Payment screenshot
/// and OB Quote uploads are tracked as LeadFile rows (fileType
/// PAYMENT_SCREENSHOT / OB_QUOTE, stage PROPOSAL_DISCUSSION), not columns
/// here — consistent with how other stage-gate file requirements work.
model PDOBChecklist {
  id                   String    @id @default(cuid())
  leadId               String    @unique
  paymentValue         Float?
  projectValue         Float?
  /// Furniture value (pre-GST, post-discount) — kept separate from projectValue,
  /// which excludes furniture.
  furnitureValue       Float?
  obMeetingScheduledAt DateTime?
  obMeetingLocation    String?
  notes                String?
  /// Admin/BL confirms the Final Pitch Presentation has been shared with the
  /// client. Required before the PD→OB welcome mail can be sent. (Replaces
  /// the former "welcome mail wording approved by client" tickbox, which is
  /// now covered by the WELCOME_MAIL_SCREENSHOT file requirement below.)
  finalPitchPresentationConfirmed Boolean @default(false)
  welcomeMailSent      Boolean   @default(false)
  welcomeMailSentAt    DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("pd_ob_checklists")
}

/// Task #54 — OB→OBM transition checklist. Created when a lead enters
/// ONBOARDING; its `completedAt` gates the ONBOARDING → ONBOARDING_MEETING
/// transition. The 7 timeline dates are required (all must be filled in)
/// before the OBM mail can be sent — they also feed the future Design
/// Pipeline timeline (task #48), but are not automatically computed here.
model OBOBMChecklist {
  id                       String    @id @default(cuid())
  leadId                   String    @unique
  // ── 8 manual timeline dates (required before send-obm-mail) ───────────────
  siteDocumentationAt      DateTime?
  initialSiteDiscussionAt  DateTime?
  layoutFinalisationAt     DateTime?
  designDiscussionAt       DateTime?
  preSignOffAt             DateTime?
  maskingAt                DateTime?
  signOffAt                DateTime?
  tentativeInteriorHandoverAt DateTime?
  // ── 7 welcome-document items: shown/confirmed pair each ───────────────────
  dexMaterialDone          Boolean   @default(false)
  dexMaterialConfirmed     Boolean   @default(false)
  creditSystemDone         Boolean   @default(false)
  creditSystemConfirmed    Boolean   @default(false)
  deepCleaningDone         Boolean   @default(false)
  deepCleaningConfirmed    Boolean   @default(false)
  paymentProcessDone       Boolean   @default(false)
  paymentProcessConfirmed  Boolean   @default(false)
  warrantyClaimDone        Boolean   @default(false)
  warrantyClaimConfirmed   Boolean   @default(false)
  continuityDone           Boolean   @default(false)
  continuityConfirmed      Boolean   @default(false)
  cancellationDone         Boolean   @default(false)
  cancellationConfirmed    Boolean   @default(false)
  npsTriggered             Boolean   @default(false)
  npsTriggeredAt           DateTime?
  /// Client has confirmed the OBM checklist details (timeline, welcome
  /// documents, etc.). Required before the OBM welcome mail can be sent —
  /// blocked at the checklist level, not just at the stage-move gate.
  clientConfirmed          Boolean   @default(false)
  obmMailSent              Boolean   @default(false)
  obmMailSentAt            DateTime?
  completedAt              DateTime?
  createdAt                DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("ob_obm_checklists")
}

